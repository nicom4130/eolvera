---
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { richTitlePair } from '../../lib/richTitle';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const entries = await reader.collections.news.all();
  const categoryEntries = await reader.collections.categories.all();
  const categoryLabels = Object.fromEntries(
    categoryEntries.map((category) => [
      category.slug,
      {
        en: category.entry.name,
        es: category.entry.nameEs || category.entry.name,
      },
    ])
  );
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { post: entry.entry, categoryLabels },
  }));
}

const { post, categoryLabels } = Astro.props;

const IMG_BASE = '/images/news/';
const imgSrc = (file?: string | null) =>
  !file ? '' : file.startsWith('/') ? file : IMG_BASE + file;

const langPair = (en?: string | null, es?: string | null) => ({
  en: en || es || '',
  es: es || en || '',
});

const formatDate = (date?: string | null) => ({
  en: date
    ? new Intl.DateTimeFormat('en', { month: 'long', day: 'numeric', year: 'numeric' }).format(
        new Date(`${date}T00:00:00`)
      )
    : '',
  es: date
    ? new Intl.DateTimeFormat('es', { month: 'long', day: 'numeric', year: 'numeric' }).format(
        new Date(`${date}T00:00:00`)
      )
    : '',
});

const labelFor = (category?: string | null) => {
  if (!category) return { en: 'News', es: 'Noticias' };
  const label = categoryLabels[category];
  return typeof label === 'object' && label !== null
    ? langPair(label.en, label.es)
    : langPair(label || category.replace(/-/g, ' '));
};

const paragraphs = (value?: string | null) =>
  (value || '')
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

const title = richTitlePair(post.title, post.titleEs, post.titleRich, post.titleRichEs);
const excerpt = langPair(post.excerpt, post.excerptEs);
const category = labelFor(post.category);
const date = formatDate(post.date);
const bodyEn = paragraphs(post.body || post.excerpt);
const bodyEs = paragraphs(post.bodyEs || post.excerptEs || post.body || post.excerpt);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title.enText} — Enrique Olvera</title>
  <meta name="description" content={excerpt.en || title.enText} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,400;1,6..96,500&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/sofiapro-light.otf" as="font" type="font/otf" crossorigin />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

  <Masthead />

  <main class="post-page">
    <article class="post">
      <header class="post__head">
        <a class="post__back" href="/news" data-i18n="archive">Archive</a>
        <p class="post__meta" data-lang-content="en">{category.en}{date.en && ` / ${date.en}`}</p>
        <p class="post__meta" data-lang-content="es" hidden>{category.es}{date.es && ` / ${date.es}`}</p>
        <h1 class="post__title">
          <span data-lang-content="en" set:html={title.enHtml}></span>
          <span data-lang-content="es" hidden set:html={title.esHtml}></span>
        </h1>
        {(excerpt.en || excerpt.es) && (
          <>
            <p class="post__dek" data-lang-content="en">{excerpt.en}</p>
            <p class="post__dek" data-lang-content="es" hidden>{excerpt.es}</p>
          </>
        )}
      </header>

      <figure class="post__figure">
        <img src={imgSrc(post.image)} alt="" decoding="async" />
      </figure>

      <div class="post__body" data-lang-content="en">
        {bodyEn.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="post__body" data-lang-content="es" hidden>
        {bodyEs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {post.link && (
        <p class="post__external">
          <a href={post.link} target="_blank" rel="noopener noreferrer" data-i18n="externalLink">External Link</a>
        </p>
      )}
    </article>
  </main>

  <Footer />

  <script src="/script.js" is:inline></script>
</body>
</html>

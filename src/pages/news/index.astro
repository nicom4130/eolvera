---
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { richTitlePair } from '../../lib/richTitle';

const reader = createReader(process.cwd(), keystaticConfig);
const entries = await reader.collections.news.all();
const categoryEntries = await reader.collections.categories.all();

const IMG_BASE = '/images/news/';
const imgSrc = (file?: string | null) =>
  !file ? '' : file.startsWith('/') ? file : IMG_BASE + file;

const langPair = (en?: string | null, es?: string | null) => ({
  en: en || es || '',
  es: es || en || '',
});

const formatDate = (date?: string | null) => ({
  en: date
    ? new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(
        new Date(`${date}T00:00:00`)
      )
    : '',
  es: date
    ? new Intl.DateTimeFormat('es', { month: 'long', year: 'numeric' }).format(
        new Date(`${date}T00:00:00`)
      )
    : '',
});

const categoryLabels = new Map(
  categoryEntries.map((category) => [
    category.slug,
    langPair(category.entry.name, category.entry.nameEs),
  ])
);
const labelFor = (category?: string | null) => {
  if (!category) return { en: 'News', es: 'Noticias' };
  return categoryLabels.get(category) || langPair(category.replace(/-/g, ' '));
};

const posts = entries
  .map((e) => ({ slug: e.slug, ...e.entry }))
  .sort((a, b) => ((a.date ?? '') < (b.date ?? '') ? 1 : -1));

const usedCategories = new Set(posts.map((post) => post.category).filter(Boolean));
const categories = categoryEntries
  .map((category) => category.slug)
  .filter((slug) => usedCategories.has(slug));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Archive — Enrique Olvera</title>
  <meta name="description" content="News archive from the gastronomic universe of Enrique Olvera." />
  <link rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/sofiapro-light.otf" as="font" type="font/otf" crossorigin />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

  <Masthead />

  <main class="archive-page">
    <header class="archive-head">
      <h1 class="archive-head__title" data-i18n="archive">Archive</h1>
      <nav class="archive-filter" aria-label="News categories" data-news-filters>
        <button class="archive-filter__button is-active" type="button" data-filter="all" data-i18n="all">All</button>
        {categories.map((category) => {
          const label = labelFor(category);

          return (
            <button class="archive-filter__button" type="button" data-filter={category}>
              <span data-lang-content="en">{label.en}</span>
              <span data-lang-content="es" hidden>{label.es}</span>
            </button>
          );
        })}
      </nav>
    </header>

    <section class="archive-grid" aria-label="News archive" data-news-grid>
      {posts.map((post) => {
        const title = richTitlePair(post.title, post.titleEs, post.titleRich, post.titleRichEs);
        const excerpt = langPair(post.excerpt, post.excerptEs);
        const category = labelFor(post.category);
        const date = formatDate(post.date);

        return (
          <article class="archive-card" data-category={post.category || ''}>
            <a class="archive-card__link" href={`/news/${post.slug}/`}>
              <figure class="archive-card__figure">
                <img src={imgSrc(post.image)} alt="" loading="lazy" decoding="async" />
              </figure>
              <div class="archive-card__body">
                <span class="archive-card__meta" data-lang-content="en">{category.en}{date.en && ` / ${date.en}`}</span>
                <span class="archive-card__meta" data-lang-content="es" hidden>{category.es}{date.es && ` / ${date.es}`}</span>
                <h2 class="archive-card__title">
                  <span data-lang-content="en" set:html={title.enHtml}></span>
                  <span data-lang-content="es" hidden set:html={title.esHtml}></span>
                </h2>
                {(excerpt.en || excerpt.es) && (
                  <>
                    <p class="archive-card__excerpt" data-lang-content="en">{excerpt.en}</p>
                    <p class="archive-card__excerpt" data-lang-content="es" hidden>{excerpt.es}</p>
                  </>
                )}
              </div>
            </a>
          </article>
        );
      })}
    </section>
  </main>

  <Footer />

  <script src="/script.js" is:inline></script>
</body>
</html>

---
// ============================================================
//  ENRIQUE OLVERA — home (front-page news)
//  Static page. Masthead + mega-menu live in <Masthead/> (shared). Only the
//  NEWS section is dynamic: cards come from the Keystatic `news` collection,
//  read at build time. Ordered by date desc; the pinned one (or newest) leads.
// ============================================================
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { richTitlePair } from '../lib/richTitle';

const reader = createReader(process.cwd(), keystaticConfig);

const entries = await reader.collections.news.all();

// newest first; pinned stories still rise to the front, but the home shows a
// strict four-story editorial row.
const news = entries
  .map((e) => ({ slug: e.slug, ...e.entry }))
  .sort((a, b) => {
    const pinned = Number(Boolean(b.pinned)) - Number(Boolean(a.pinned));
    if (pinned) return pinned;
    return (a.date ?? '') < (b.date ?? '') ? 1 : -1;
  });

// The Keystatic image field stores only the filename; resolve it against the
// field's publicPath so the <img src> points at the real file under /public.
const IMG_BASE = '/images/news/';
const imgSrc = (file?: string | null) =>
  !file ? '' : file.startsWith('/') ? file : IMG_BASE + file;

const langPair = (en?: string | null, es?: string | null) => ({
  en: en || es || '',
  es: es || en || '',
});

const featuredNews = news.slice(0, 4);

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enrique Olvera</title>
  <meta name="description" content="The gastronomic universe of Enrique Olvera — news, restaurants and projects." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />

  <!-- Type system: Bodoni Moda (display Didone) + locally-bundled Sofia Pro
       (the only sans — used for body and all labels). -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,400;1,6..96,500&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/sofiapro-light.otf" as="font" type="font/otf" crossorigin />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="home">

  <Masthead />

  <!-- ░░ HOME — the content is a four-column news front page ░░ -->
  <main class="paper" id="top">

    <a id="news"></a>
    <section class="front" aria-label="News">
      <div class="news-grid" id="mosaic">
        {featuredNews.map((item) => {
          const title = richTitlePair(item.title, item.titleEs, item.titleRich, item.titleRichEs);
          const excerpt = langPair(item.excerpt, item.excerptEs);

          return (
            <article class="story">
              <img class="story__image" src={imgSrc(item.image)} alt="" loading="lazy" decoding="async" />
              <a class="story__inner" href={`/news/${item.slug}/`} aria-label={title.enText}>
                <div class="story__text">
                  <h3 class="story__title">
                    <span data-lang-content="en" set:html={title.enHtml}></span>
                    <span data-lang-content="es" hidden set:html={title.esHtml}></span>
                  </h3>
                  <span class="story__rule" aria-hidden="true"></span>
                  {(excerpt.en || excerpt.es) && (
                    <>
                      <p class="story__expert" data-lang-content="en">{excerpt.en}</p>
                      <p class="story__expert" data-lang-content="es" hidden>{excerpt.es}</p>
                    </>
                  )}
                </div>
              </a>
            </article>
          );
        })}
      </div>
      <a class="front__archive" href="/news" data-i18n="archive">Archive</a>
    </section>

  </main>

  <Footer />

  <script src="/script.js" is:inline></script>
</body>
</html>

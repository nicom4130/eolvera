---
// ============================================================
//  ENRIQUE OLVERA — home (front-page news)
//  Static page. Masthead + mega-menu live in <Masthead/> (shared). Only the
//  NEWS section is dynamic: cards come from the Keystatic `news` collection,
//  read at build time. Ordered by date desc; the pinned one (or newest) leads.
// ============================================================
import Masthead from '../components/Masthead.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);

const entries = await reader.collections.news.all();

// newest first; the most recent is the lead, the rest fill the mosaic
const news = entries
  .map((e) => e.entry)
  .sort((a, b) => ((a.date ?? '') < (b.date ?? '') ? 1 : -1));

// The Keystatic image field stores only the filename; resolve it against the
// field's publicPath so the <img src> points at the real file under /public.
const IMG_BASE = '/images/news/';
const imgSrc = (file?: string | null) =>
  !file ? '' : file.startsWith('/') ? file : IMG_BASE + file;

// The editor can pin any story as the front-page lead; the most recent pinned
// one wins. With nothing pinned we fall back to the newest story (old behavior).
const lead = news.find((n) => n.pinned) ?? news[0];
const rest = news.filter((n) => n !== lead);

// "April 2026" style label from an ISO date string
function monthYear(iso?: string | null) {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enrique Olvera</title>
  <meta name="description" content="The gastronomic universe of Enrique Olvera — news, restaurants and projects." />

  <!-- Type system: Bodoni Moda (display Didone) + locally-bundled Sofia Pro
       (the only sans — used for body and all labels). -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/sofiapro-light.otf" as="font" type="font/otf" crossorigin />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

  <Masthead />

  <!-- ░░ HOME — the content is the news, laid out as a front-page mosaic ░░ -->
  <main class="paper" id="top">

    <a id="news"></a>
    <section class="front" aria-label="News">

      {lead && (
        <article class="lead">
          <a class="lead__media" href={lead.link} target="_blank" rel="noopener noreferrer">
            <img src={imgSrc(lead.image)} alt={lead.title} loading="eager" decoding="async" />
          </a>
          <div class="lead__body">
            <span class="lead__date">{monthYear(lead.date)}</span>
            <h2 class="lead__title">{lead.title}</h2>
            {lead.excerpt && <p class="lead__dek">{lead.excerpt}</p>}
            <a class="lead__go" href={lead.link} target="_blank" rel="noopener noreferrer">View +</a>
          </div>
        </article>
      )}

      <div class="rule rule--hair front__split"></div>

      <div class="mosaic" id="mosaic">
        {rest.map((item) => (
          <article class="story" data-size={item.size ?? 'normal'}>
            <div class="story__inner">
              <a class="story__media" href={item.link} target="_blank" rel="noopener noreferrer">
                <img src={imgSrc(item.image)} alt={item.title} loading="lazy" decoding="async" />
              </a>
              <span class="story__date">{monthYear(item.date)}</span>
              <h3 class="story__title">{item.title}</h3>
              <a class="story__go" href={item.link} target="_blank" rel="noopener noreferrer">View +</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer class="colophon">
      <span>&copy;2026 — Taller Enrique Olvera</span>
      <span class="colophon__credit">Murlender Design &times; Nico</span>
    </footer>
  </main>

  <script src="/script.js" is:inline></script>
</body>
</html>

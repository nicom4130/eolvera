---
// ============================================================
//  ENRIQUE OLVERA — Consulting
//  Copy ported from proposal 3. Framed contact form (our own /api/contact).
// ============================================================
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enrique Olvera — Consulting</title>
  <meta name="description" content="Comprehensive consulting by Enrique Olvera — conceptualization, creative support and feasibility analysis, in Mexico and abroad." />
  <link rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/sofiapro-light.otf" as="font" type="font/otf" crossorigin />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="page-consulting">

  <Masthead />

  <main class="paper" id="top">
    <section class="cpage cpage--consulting" aria-label="Consulting">
      <div class="cbox cbox--consulting">
        <h1 class="cbox__title" data-i18n="consulting">Consulting</h1>
        <p class="cbox__lead" data-lang-content="en">In addition to the creative direction of the hospitality projects grouped under Casamata, Enrique Olvera&rsquo;s experience and his interest in sharing the knowledge gained have led to comprehensive consulting for projects that require it. This includes conceptualization, creative support, and feasibility analysis, whether it be for overall proposals, context, or operations, both in Mexico and abroad.</p>
        <p class="cbox__lead" data-lang-content="es" hidden>Además de la dirección creativa de los proyectos de hospitalidad agrupados bajo Casamata, la experiencia de Enrique Olvera y su interés por compartir el conocimiento adquirido lo han llevado a ofrecer consultoría integral para proyectos que lo requieren. Esto incluye conceptualización, apoyo creativo y análisis de viabilidad, ya sea para propuestas generales, contexto u operación, tanto en México como en el extranjero.</p>
        <form class="cform cform--inline" action="/api/contact" method="post" data-cform>
          <input type="hidden" name="source" value="consulting" />
          <input type="hidden" name="_t" value="" data-cform-ts />
          <input type="hidden" name="name" value="Consulting inquiry" />
          <input type="hidden" name="message" value="Consulting inquiry from email-only form." />
          <input type="hidden" name="company" value="" autocomplete="off" />
          <label class="cform__label" for="consulting-email" data-i18n="email">Email</label>
          <div class="cform__inline-row">
            <input class="cform__input" id="consulting-email" name="email" type="email" autocomplete="email" required />
            <button class="cform__submit" type="submit"><span data-i18n="getInTouch">Get in touch</span></button>
          </div>
        </form>
        <p class="cbox__note" data-lang-content="en">Press &amp; enquiries, <a href="mailto:hola@enriqueolvera.com">hola@enriqueolvera.com</a></p>
        <p class="cbox__note" data-lang-content="es" hidden>Prensa y consultas, <a href="mailto:hola@enriqueolvera.com">hola@enriqueolvera.com</a></p>
      </div>
    </section>

  </main>

  <Footer />

  <script src="/script.js" is:inline></script>
</body>
</html>

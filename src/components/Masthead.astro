---
// Shared masthead + NYT-style mega-menu. Used by every page so the nav stays
// in one place. Links are absolute (`/`, `/#news`, `/about`) so they work from
// any route. The hover/mega + EN/ES behavior lives in /script.js.
---
<!-- ░░ MASTHEAD — newspaper front page (NYT-style), name set in place of a logo ░░ -->
<header class="masthead" id="masthead">

  <!-- the name replaces the logotype; language sits on the same row -->
  <div class="masthead__top">
    <a
      class="masthead__title"
      href="/"
      aria-label="Enrique Olvera home"
    >ENRIQUE OLVERA</a>
    <div class="lang" data-lang>
      <button class="lang__opt is-active" data-lang-set="en" type="button" aria-pressed="true">EN</button>
      <span class="lang__sep" aria-hidden="true">/</span>
      <button class="lang__opt" data-lang-set="es" type="button" aria-pressed="false">ES</button>
    </div>
    <!-- hamburger — mobile only (CSS hides it on desktop) -->
    <button class="mham" id="mham" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mnav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- section ribbon — NYT horizontal nav. Hovering a group drops a
       full-width mega menu (#mega) with that group's full directory. -->
  <nav class="ribbon" aria-label="Sections">
    <a class="ribbon__link" href="#" data-mega="Casamata">Casamata</a>
    <a class="ribbon__link" href="#" data-mega="Teo">Teo</a>
    <a class="ribbon__link" href="#" data-mega="Casa Teo">Casa Teo</a>
    <a class="ribbon__link" href="/consulting" data-i18n="consulting">Consulting</a>
    <a class="ribbon__link" href="#" data-mega="Projects" data-i18n="otherProjects">Other Projects</a>
    <a class="ribbon__link" href="/about" data-mega="About" data-mega-click-through data-i18n="about">About</a>
  </nav>

  <!-- ░░ MEGA MENU — NYT-style full-width dropdown. Each group is laid out as
       two columns of directory links + a preview image that swaps on hover.
       Items with a photo carry data-img; the rest leave the preview blank. ░░ -->
  <div class="mega" id="mega" aria-hidden="true">
    <div class="mega__inner">

      <section class="mega__panel" data-panel="Casamata">
        <div class="mega__col mega__col--left">
          <a class="mega__item" href="https://www.pujol.com.mx" target="_blank" rel="noopener noreferrer" data-img="/img/menu/pujol.webp"><span class="mega__name">Pujol</span><span class="mega__meta" data-i18n="mexicoCity">Mexico City</span></a>
          <a class="mega__item" href="https://www.pujol.com.mx/en/molino-el-pujol" target="_blank" rel="noopener noreferrer" data-img="/img/news/pujol.webp"><span class="mega__name">Molino &ldquo;El Pujol&rdquo;</span><span class="mega__meta" data-i18n="mexicoCity">Mexico City</span></a>
          <a class="mega__item" href="#"><span class="mega__name">Pujol Central</span><span class="mega__meta" data-i18n="autumn26">Opening Autumn 2026</span></a>
          <a class="mega__item" href="#"><span class="mega__name">pujol.itto</span><span class="mega__meta" data-i18n="spring26">Opening Spring 2026</span></a>
          <a class="mega__item" href="#"><span class="mega__name">Hoster&iacute;a Pujol</span><span class="mega__meta" data-i18n="open28">Opening 2028</span></a>
          <a class="mega__item" href="https://www.ticuchi.mx/" target="_blank" rel="noopener noreferrer" data-img="/img/news/ticuchi.webp"><span class="mega__name">Ticuchi</span><span class="mega__meta" data-i18n="mexicoCity">Mexico City</span></a>
        </div>
        <figure class="mega__preview" aria-hidden="true">
          <img class="mega__preview-img" alt="" decoding="async" />
          <img class="mega__preview-img" alt="" decoding="async" />
        </figure>
        <div class="mega__col mega__col--right">
          <a class="mega__item" href="https://cosmenyc.com" target="_blank" rel="noopener noreferrer" data-img="/img/menu/cosme-duck-carnitas.webp"><span class="mega__name">Cosme</span><span class="mega__meta" data-i18n="newYork">New York</span></a>
          <a class="mega__item" href="#"><span class="mega__name">Cosme Bar</span><span class="mega__meta" data-i18n="autumn26">Opening Autumn 2026</span></a>
          <a class="mega__item" href="https://www.essetaco.com" target="_blank" rel="noopener noreferrer"><span class="mega__name">Esse Taco</span><span class="mega__meta">Brooklyn</span></a>
          <a class="mega__item" href="https://damiandtla.com" target="_blank" rel="noopener noreferrer" data-img="/img/news/damian.webp"><span class="mega__name">Damian</span><span class="mega__meta" data-i18n="losAngeles">Los Angeles</span></a>
          <a class="mega__item" href="https://www.instagram.com/ditroitdtla" target="_blank" rel="noopener noreferrer" data-img="/img/menu/ditroit.webp"><span class="mega__name">Ditroit</span><span class="mega__meta" data-i18n="losAngeles">Los Angeles</span></a>
          <a class="mega__item" href="#"><span class="mega__name">San Damian</span><span class="mega__meta" data-i18n="summer26">Opening Summer 2026</span></a>
        </div>
      </section>

      <section class="mega__panel" data-panel="Casa Teo">
        <div class="mega__col mega__col--left">
          <a class="mega__item" href="https://boutique-homes.com/property/casa-teo-1" target="_blank" rel="noopener noreferrer"><span class="mega__name">Casa Teo 1</span><span class="mega__meta" data-i18n="mexicoCity">Mexico City</span></a>
          <a class="mega__item" href="https://www.airbnb.com/rooms/1179714470415714280" target="_blank" rel="noopener noreferrer"><span class="mega__name">Casa Teo 2</span><span class="mega__meta" data-i18n="mexicoCity">Mexico City</span></a>
        </div>
        <figure class="mega__preview" aria-hidden="true">
          <img class="mega__preview-img" alt="" decoding="async" />
          <img class="mega__preview-img" alt="" decoding="async" />
        </figure>
        <div class="mega__col mega__col--right">
          <a class="mega__item mega__item--single-rule" href="https://www.teo.casa/" target="_blank" rel="noopener noreferrer"><span class="mega__name">Takonoma</span><span class="mega__meta" data-i18n="shop">Shop</span></a>
        </div>
      </section>

      <section class="mega__panel" data-panel="Teo">
        <div class="mega__col mega__col--left">
          <a class="mega__item" href="https://www.instagram.com/criollo_oax" target="_blank" rel="noopener noreferrer"><span class="mega__name">Criollo Oaxaca</span><span class="mega__meta">Oaxaca</span></a>
          <a class="mega__item" href="https://www.airbnb.com/rooms/37160054" target="_blank" rel="noopener noreferrer" data-img="/img/menu/casa-criollo.jpg"><span class="mega__name">Casa Criollo</span><span class="mega__meta">Oaxaca</span></a>
          <a class="mega__item" href="https://www.mantarestaurant.com" target="_blank" rel="noopener noreferrer" data-img="/img/news/manta.webp"><span class="mega__name">Manta</span><span class="mega__meta">Los Cabos</span></a>
        </div>
        <figure class="mega__preview" aria-hidden="true">
          <img class="mega__preview-img" alt="" decoding="async" />
          <img class="mega__preview-img" alt="" decoding="async" />
        </figure>
        <div class="mega__col mega__col--right">
          <a class="mega__item" href="https://casamata.com/refugio/" target="_blank" rel="noopener noreferrer"><span class="mega__name">Refugio</span><span class="mega__meta" data-i18n="open27">Opening 2027</span></a>
          <a class="mega__item" href="#"><span class="mega__name">San Jos&eacute; del Criollo</span><span class="mega__meta" data-i18n="summer26">Opening Summer 2026</span></a>
          <a class="mega__item" href="https://www.oneandonlyresorts.com/mandarina/dining/carao" target="_blank" rel="noopener noreferrer" data-img="/img/menu/carao.webp"><span class="mega__name">Carao</span><span class="mega__meta">Mandarina</span></a>
        </div>
      </section>

      <section class="mega__panel" data-panel="Projects">
        <div class="mega__col mega__col--left">
          <a class="mega__item" href="https://roselosangeles.com" target="_blank" rel="noopener noreferrer" data-img="/img/menu/rose.jpg"><span class="mega__name">Rose Los Angeles</span><span class="mega__meta" data-i18n="losAngeles">Los Angeles</span></a>
          <a class="mega__item" href="https://www.elpoaig.com/en" target="_blank" rel="noopener noreferrer" data-img="/img/menu/poaig.jpg"><span class="mega__name">La Poaig</span><span class="mega__meta">Olive Oil</span></a>
        </div>
        <figure class="mega__preview" aria-hidden="true">
          <img class="mega__preview-img" alt="" decoding="async" />
          <img class="mega__preview-img" alt="" decoding="async" />
        </figure>
        <div class="mega__col mega__col--right">
          <a class="mega__item" href="https://manojomezcal.com" target="_blank" rel="noopener noreferrer" data-img="/img/menu/manojo-shopify.jpg"><span class="mega__name">Manojo Mezcal</span><span class="mega__meta">Mezcal</span></a>
          <a class="mega__item" href="https://www.instagram.com/meteostudio_" target="_blank" rel="noopener noreferrer"><span class="mega__name">Meteo Studio</span><span class="mega__meta">Design</span></a>
        </div>
      </section>

      <section class="mega__panel mega__panel--about" data-panel="About">
        <a class="mega__item" href="/about#bio"><span class="mega__name" data-i18n="bio">Bio</span></a>
        <a class="mega__item" href="/about#contact"><span class="mega__name" data-i18n="contact">Contact</span></a>
      </section>

    </div>
  </div>

  <!-- ░░ MOBILE MENU — accordion drawer (mobile only). Mirrors the mega's
       directory; the desktop mega and this list are kept in sync by hand. ░░ -->
  <div class="mnav" id="mnav" aria-hidden="true">
    <div class="mnav__inner">

      <div class="macc" data-acc>
        <button class="macc__head" type="button" aria-expanded="false">Casamata</button>
        <div class="macc__body">
          <a class="macc__item" href="https://www.pujol.com.mx" target="_blank" rel="noopener noreferrer">Pujol<em data-i18n="mexicoCity">Mexico City</em></a>
          <a class="macc__item" href="https://www.pujol.com.mx/en/molino-el-pujol" target="_blank" rel="noopener noreferrer">Molino &ldquo;El Pujol&rdquo;<em data-i18n="mexicoCity">Mexico City</em></a>
